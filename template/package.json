{
  "name": "super-seed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "types": "wrangler types",
    "db:types": "node scripts/db-types.ts",
    "db:migrate:local": "wrangler d1 migrations apply super-seed --local",
    "db:migrate:remote": "wrangler d1 migrations apply super-seed --remote",
    "setup:local": "wrangler types && node scripts/db-types.ts && tsr generate && wrangler d1 migrations apply super-seed --local",
    "setup:remote": "node scripts/setup-remote.ts",
    "email": "email dev --dir src/emails --port 3030",
    "check": "pnpm types && node scripts/db-types.ts --verify && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test",
    "operator:add": "node scripts/operator.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.6",
    "@better-auth/stripe": "^1.7.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.59",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "kysely": "^0.29.6",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@react-email/ui": "^6.11.0",
    "@tanstack/router-cli": "^1.167.39",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^12.11.1",
    "kysely-codegen": "^0.20.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@11.9.0"
}
